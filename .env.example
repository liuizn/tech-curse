# Modelo do arquivo .env. Copie para .env e SUBSTITUA todos os valores abaixo.
# Nenhum valor deste arquivo deve ser usado como está: são placeholders, não
# credenciais. O .env real fica fora do controle de versão (ver .gitignore).

# Mínimo de 32 caracteres — o startup lança exceção se a chave for menor.
# Gere uma chave aleatória, por exemplo:
#   openssl rand -base64 48
JWT_SIGNING_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_NO_MINIMO_32_CARACTERES
JWT_ISSUER=SUBSTITUA_PELO_ISSUER
JWT_AUDIENCE=SUBSTITUA_PELA_AUDIENCE

DB_PASSWORD=SUBSTITUA_PELA_SENHA_DO_SQL_SERVER
REDIS_PASSWORD=SUBSTITUA_PELA_SENHA_DO_REDIS
SEQ_PASSWORD=SUBSTITUA_PELA_SENHA_DO_SEQ

# Opcional. O docker-compose assume Development quando ausente.
# ASPNETCORE_ENVIRONMENT=Development

# Opcional. Nome da imagem da API; o docker-compose assume tech-curse-api:local.
# O pipeline usa esta variavel para validar exatamente a imagem que acabou de
# construir, em vez de reconstruir uma equivalente.
# API_IMAGE=tech-curse-api:local
